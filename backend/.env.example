SECRET_KEY=replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,baharnaj.ir,www.baharnaj.ir
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional fallback for serialization without an HTTP request context:
PUBLIC_BACKEND_URL=
# Public frontend domain used for canonical sitemap URLs (no trailing slash).
SITE_URL=https://baharnaj.ir
DEFAULT_FROM_EMAIL=no-reply@baharnaj.local
# Keep customer self-service changes disabled until the salon approves its policy.
CUSTOMER_APPOINTMENT_POLICY_CONFIGURED=false
# Firebase Admin is optional for local web development. Use a mounted file for FCM:
FIREBASE_PROJECT_ID=baharnaj
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=baharnaj-firebase-adminsdk.json

# Optional: defaults to backend/db.sqlite3
# SQLITE_PATH=/absolute/path/to/db.sqlite3

# Telegram / TeleBotHost. Outbound sending is disabled by default.
TELEGRAM_ENABLED=false
TELEGRAM_DRY_RUN=true
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTEGRATION_SECRET=
TELEGRAM_BATCH_SIZE=20
TELEGRAM_MAX_PER_MINUTE=20
# Set PUBLIC_BACKEND_URL and SITE_URL above to HTTPS public origins before activation.
# Schedule `python manage.py telegram_worker` once per minute, one instance.
# Emergency stop overrides the admin panel's saved sending mode.
TELEGRAM_FORCE_DISABLED=false
CSRF_TRUSTED_ORIGINS=http://localhost:5173
