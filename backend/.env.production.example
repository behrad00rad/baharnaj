# PRIVATE runtime configuration. Copy OUTSIDE the checkout; chmod 600.
SECRET_KEY=replace-me-with-a-new-random-secret-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=baharnaj.ir,www.baharnaj.ir
CORS_ALLOWED_ORIGINS=https://baharnaj.ir,https://www.baharnaj.ir
CSRF_TRUSTED_ORIGINS=https://baharnaj.ir,https://www.baharnaj.ir
SITE_URL=https://baharnaj.ir
PUBLIC_BACKEND_URL=https://baharnaj.ir
SECURE_SSL_REDIRECT=True
# Start short AFTER HTTPS verification. Increase later; subdomains/preload need review.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
REFRESH_COOKIE_SECURE=True
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=60
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Required: operator supplies working SMTP. No delivery tests in Phase 0.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@baharnaj.ir
# Enable only after cancellation/rescheduling wording and deadlines are approved.
CUSTOMER_APPOINTMENT_POLICY_CONFIGURED=false
# Private Firebase Admin reference only; intentionally NOT mounted in Phase 0.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_PROJECT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_DRY_RUN=true
TELEGRAM_FORCE_DISABLED=true
# Preserve existing Telegram encryption credentials in the backed-up secret file.
