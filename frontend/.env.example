# Relative URLs use Vite's development proxy and work locally or in Codespaces.
VITE_API_BASE_URL=/api/v1/
# Optional for a separately hosted production API/media server:
# VITE_MEDIA_URL=https://your-backend-domain.example.com
# Optional proxy target when the backend is not at 127.0.0.1:8000:
# VITE_PROXY_TARGET=http://127.0.0.1:8000
